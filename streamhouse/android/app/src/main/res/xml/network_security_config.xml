<?xml version="1.0" encoding="utf-8"?>
<!-- StreamHouse runs on the local network over plain HTTP, which Android
     blocks by default from API 28 onwards. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
