# Windows launcher scripts must keep CRLF: cmd.exe mis-parses LF-only batch
# files, and the repository is checked out on both Linux and Windows.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets - never rewrite line endings inside these.
*.ico binary
*.png binary
*.jar binary
*.apk binary
